# Copy this file to .env and fill in your own values.

# Use a long random value, it also signs the JWTs
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to True when the backend runs behind HTTPS
JWT_COOKIE_SECURE=False

# Free key from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
# Comma separated, the next model is used when one is overloaded
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest

# Whisper model: tiny, base, small, medium, large
WHISPER_MODEL=base
MAX_VIDEO_MINUTES=20
